# Path to your Obsidian vault
NOTE_ROOT=/path/to/folder

# Hybrid LLM reviewer (advisory second pass over Wikipedia extracts).
# Set LLM_ENABLED=false to disable. First run downloads the model (default ~1GB).
#LLM_ENABLED=true
#LLM_MODEL_ID=onnx-community/Qwen2.5-1.5B-Instruct
#LLM_MAX_INPUT_CHARS=16000
#LLM_GATE=always

# Noise-rejection pass: the LLM may also remove regex names that are not
# genuine common names (allowlisted categories + cap applied by the reviewer).
# Set LLM_REJECT_ENABLED=false to keep add-only behavior.
#LLM_REJECT_ENABLED=true
#LLM_REJECT_MAX=3

# Review-gap tally log. Caught names can be promoted to regression tests via
# `npm run tally -- --regressions=3`. Default logs only runs that found new names.
#REVIEW_LOG_PATH=.review-data/review-gaps.jsonl
#REVIEW_LOG_ALL=false
